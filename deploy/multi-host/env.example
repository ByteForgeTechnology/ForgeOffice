# One .env per machine (copy this file to .env next to docker-compose.yml).
# The first block is the same on every machine; the second differs.
# The installer (build/install.sh, Custom) writes these for you; the join code
# (admin center: Organisation > Servers & storage > Add a server) carries the
# shared block from one server to the next.

# --- The same everywhere -----------------------------------------------------
FORGE_PUBLIC_URL=https://office.example.com
FORGE_MAIL_HOSTNAME=mail.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Shared by every machine: signs tokens and encrypts the keys kept in the database.
# Generate once: openssl rand -hex 32
FORGE_SECRET=
FORGE_IMAGE=registry.example.com/forgeoffice:1.0
# The machine running Postgres and Redis (COMPOSE_PROFILES=data).
FORGE_DB_HOST=10.0.0.10
# Storage nodes to start from (they also announce themselves in Redis).
FORGE_STORE_NODES=http://10.0.0.31:8096,http://10.0.0.32:8096
# Copies of every file (capped at the number of storage nodes).
FORGE_STORE_REPLICAS=2

# --- This machine ----------------------------------------------------------------
# Its private address (services publish their ports here).
FORGE_BIND=10.0.0.31
# What it runs (see docker-compose.yml).
COMPOSE_PROFILES=store,media
# Media servers: this machine's address as browsers see it (public or LAN IP).
FORGE_RTC_ANNOUNCED_IP=203.0.113.31
FORGE_MACHINE_NAME=machine-31

# --- On the gateway machine ---------------------------------------------------------
# HTTPS on your own domain: add tls to COMPOSE_PROFILES, and
# FORGE_DOMAIN=office.example.com
# FORGE_HTTP_BIND=127.0.0.1
# FORGE_HTTP_PORT=8080
# Where each service runs:
# Several addresses = several copies, balanced by the gateway (least busy, health-checked).
# Unset = this machine (the service runs here).
# FORGE_UPSTREAM_DIRECTORY=10.0.0.21:8091 10.0.0.22:8091
# FORGE_UPSTREAM_MAIL_API=10.0.0.21:8092 10.0.0.22:8092
# FORGE_UPSTREAM_CALENDAR_API=10.0.0.21:8093
# FORGE_UPSTREAM_CONTACTS_API=10.0.0.21:8094
# FORGE_UPSTREAM_TASKS_API=10.0.0.21:8095
# FORGE_UPSTREAM_DRIVE_API=10.0.0.21:8097 10.0.0.22:8097
# FORGE_UPSTREAM_TEAM_API=10.0.0.21:8098 10.0.0.22:8098
# FORGE_UPSTREAM_PORTAL_WEB=10.0.0.20:8081
# FORGE_UPSTREAM_MAIL_WEB=10.0.0.20:8082
# FORGE_UPSTREAM_CALENDAR_WEB=10.0.0.20:8083
# FORGE_UPSTREAM_CONTACTS_WEB=10.0.0.20:8084
# FORGE_UPSTREAM_TASKS_WEB=10.0.0.20:8085
# FORGE_UPSTREAM_ADMIN_WEB=10.0.0.20:8086
# FORGE_UPSTREAM_DRIVE_WEB=10.0.0.20:8087
# FORGE_UPSTREAM_SITES_WEB=10.0.0.20:8088
# FORGE_UPSTREAM_TEAM_WEB=10.0.0.20:8089
