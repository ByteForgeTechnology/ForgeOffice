# --- Required -----------------------------------------------------------------
# Public URL users reach ForgeOffice on (scheme + host, no trailing slash).
# It becomes the OIDC issuer; changing it later invalidates existing sessions.
FORGE_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Host name of the mail server: the MX target, the name in SMTP greetings and
# what mail apps connect to. Must match the TLS certificate.
FORGE_MAIL_HOSTNAME=mail.example.com

# --- Optional -----------------------------------------------------------------
# TLS certificate for SMTP/IMAP (PEM). Defaults to forge_certs/tls/{fullchain,privkey}.pem;
# a self-signed certificate is generated if neither exists. With the Caddy profile:
# FORGE_TLS_CERT=/data/certs/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.example.com/mail.example.com.crt
# FORGE_TLS_KEY=/data/certs/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.example.com/mail.example.com.key

# Send outgoing mail through a smarthost instead of directly to recipients' MX
# (needed when your ISP or cloud provider blocks outbound port 25).
# Fallback relay; usually set in Admin → ForgeMail → Mail settings instead.
# FORGE_SMTP_RELAY=smtp://user:password@smtp.relay.example:587

# Skip SPF/DKIM/DMARC checks on inbound mail (not recommended in production).
# FORGE_MAIL_DISABLE_AUTH_CHECKS=false

# Master secret for cookie signing and MFA secret encryption (>= 32 chars).
# If unset, one is generated on first boot and kept in the forge_certs volume.
# FORGE_SECRET=

# Fixed setup token for the first-run wizard (otherwise generated and logged).
# FORGE_SETUP_TOKEN=

# Host port for the gateway (the one address browsers and apps use), and the
# interface it listens on: 127.0.0.1 when the TLS proxy below is the way in.
# FORGE_HTTP_PORT=8080
# FORGE_HTTP_BIND=0.0.0.0

# Mail ports on this machine (other mail servers only deliver to 25).
# FORGE_SMTP_HOST_PORT=25
# FORGE_SUBMISSION_HOST_PORT=587
# FORGE_SUBMISSIONS_HOST_PORT=465
# FORGE_IMAP_HOST_PORT=143
# FORGE_IMAPS_HOST_PORT=993

# The image release to run (the installer sets these) and the Compose project.
# FORGE_VERSION=latest
# FORGE_IMAGE=forgeoffice/app:latest
# COMPOSE_PROJECT_NAME=forgeoffice

# Every container also publishes its own port (8081–8099); by default only on
# this machine. 0.0.0.0 exposes them too (browsers should still use the gateway).
# FORGE_SERVICE_BIND=127.0.0.1

# --- ForgeDrive extras ---------------------------------------------------------
# Virus scanning of uploads with ClamAV (docker compose --profile av up -d).
# Without it, files are marked "not scanned" and are still usable.
# FORGE_CLAMAV=clamav:3310

# Edit Office documents in the browser with Euro-Office
# (docker compose --profile office up -d). Must be reachable by browsers.
# FORGE_OFFICE_URL=http://localhost:9980
# Shared with the document server (its JWT_SECRET), at least 32 characters:
# openssl rand -hex 32
# FORGE_OFFICE_JWT_SECRET=
# Where drive-api reaches the editor (server to server).
# FORGE_OFFICE_INTERNAL_URL=http://office
# Collabora Online instead of Euro-Office: FORGE_OFFICE_PROTOCOL=wopi
# FORGE_OFFICE_PROTOCOL=docs
# Where the editor reaches ForgeDrive to open and save files (server to server).
# FORGE_WOPI_URL=http://drive-api:8097
# Pin a release instead of :latest, and choose which interface the port is on.
# FORGE_OFFICE_IMAGE=ghcr.io/euro-office/documentserver:v9.3.1
# FORGE_OFFICE_BIND=127.0.0.1

# --- Several machines (see README → Several machines) -----------------------------
# Storage nodes to use (more announce themselves in Redis), and copies of each file.
# FORGE_STORE_NODES=http://store:8096
# FORGE_STORE_REPLICAS=2
# Every call on one port instead of the 40000–40099 range (one per media server).
# FORGE_RTC_PORT=40000
# Gateway: where a service runs, when it runs on other machines or several times.
# FORGE_UPSTREAM_MAIL_API=10.0.0.21:8092 10.0.0.22:8092

# --- ForgeTeam meetings ----------------------------------------------------------
# Browsers send meeting audio and video straight to the media container on
# UDP/TCP ports 40000–40099 (cameras and microphones need HTTPS). Set this to the server's address as other
# computers reach it (its LAN IP, or its public IP); without it only this
# machine can join meetings.
# FORGE_RTC_ANNOUNCED_IP=192.168.1.20

# Trust X-Forwarded-* headers from a reverse proxy. Defaults to true in production.
# FORGE_TRUST_PROXY=true

# Domain for the optional Caddy TLS proxy (docker compose --profile tls up -d).
# Set FORGE_PUBLIC_URL=https://<this domain> and FORGE_HTTP_BIND=127.0.0.1 as well.
# More sites (e.g. the Office editor on its own domain): docker/sites/*.caddy
# FORGE_DOMAIN=office.example.com

# Live container status in the admin console (also mount the socket in compose).
# FORGE_DOCKER_SOCKET=/var/run/docker.sock

# Backups: cron schedule ("off" disables) and how many completed backups to keep.
# FORGE_BACKUP_SCHEDULE=0 2 * * *
# FORGE_BACKUP_RETENTION=7
# FORGE_AUDIT_RETENTION_DAYS=365
# FORGE_DELETED_USER_RETENTION_DAYS=30
# TZ=Europe/London

# Extra OIDC clients (JSON array) for other apps that sign in through ForgeOffice.
# FORGE_OIDC_CLIENTS=[{"client_id":"wiki","client_secret":"...","redirect_uris":["https://wiki.example.com/callback"],"token_endpoint_auth_method":"client_secret_basic","forge:first_party":true}]

# LOG_LEVEL=info
