# --- Required -----------------------------------------------------------------
# Public URL users reach ForgeOffice on (scheme + host, no trailing slash).
# It becomes the OIDC issuer; changing it later invalidates existing sessions.
FORGE_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Optional -----------------------------------------------------------------
# Master secret for cookie signing and MFA secret encryption (>= 32 chars).
# If unset, one is generated on first boot and kept in the forge_certs volume.
# FORGE_SECRET=

# Fixed setup token for the first-run wizard (otherwise generated and logged).
# FORGE_SETUP_TOKEN=

# Host port for the API/web container.
# FORGE_HTTP_PORT=8080

# Trust X-Forwarded-* headers from a reverse proxy. Defaults to true in production.
# FORGE_TRUST_PROXY=true

# Domain for the optional Caddy TLS proxy (docker compose --profile tls up -d).
# Set FORGE_PUBLIC_URL=https://<this domain> as well.
# FORGE_DOMAIN=office.example.com

# Live container status in the admin console (also mount the socket in compose).
# FORGE_DOCKER_SOCKET=/var/run/docker.sock

# Backups: cron schedule ("off" disables) and how many completed backups to keep.
# FORGE_BACKUP_SCHEDULE=0 2 * * *
# FORGE_BACKUP_RETENTION=7
# FORGE_AUDIT_RETENTION_DAYS=365
# FORGE_DELETED_USER_RETENTION_DAYS=30
# TZ=Europe/London

# Extra OIDC clients (JSON array) for other apps that sign in through ForgeOffice.
# FORGE_OIDC_CLIENTS=[{"client_id":"wiki","client_secret":"...","redirect_uris":["https://wiki.example.com/callback"],"token_endpoint_auth_method":"client_secret_basic","forge:first_party":true}]

# LOG_LEVEL=info
